{
  "name": "encore-backend",
  "version": "1.0.0",
  "description": "Encore event ingestion backend – no database, text-file storage",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "fetch:events": "node src/scheduler.js --once",
    "start:events": "node src/scheduler.js",
    "test": "jest --verbose --forceExit",
    "lint": "eslint src/ --ext .js",
    "audit": "npm audit"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "ical.js": "^2.1.0",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
